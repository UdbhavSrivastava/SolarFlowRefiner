{
  "model": "flowmatch",
  "train_index": "splits/train_index.csv",
  "val_index": "splits/val_index.csv",
  "test_index": "splits/test_index.csv",
  "out_dir": "runs/FlowMatch",
  "epochs": 100,
  "batch_size": 4,
  "lr": 0.00002,
  "weight_decay": 0.0001,
  "base_channels": 64,
  "channel_multipliers": "1,2,4,8",
  "res_blocks": 2,
  "sample_steps": 50,
  "solver": "heun",
  "time_sampling": "logit_normal",
  "loss": "l1",
  "ema_decay": 0.9999,
  "early_stopping_patience": 15,
  "early_stopping_min_delta": 0.001,
  "eval_every": 1,
  "seed": 42,
  "device": "auto"
}
