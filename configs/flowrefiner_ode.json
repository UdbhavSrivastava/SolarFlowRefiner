  "refinement_steps": 8,
  "solver": "heun",
  "endpoint_loss_weight": 0.5,
  "gradient_loss_weight": 0.05,
  "ema_decay": 0.9999,
  "early_stopping_patience": 15,
  "early_stopping_min_delta": 0.001,
  "eval_every": 1,
  "seed": 42,
  "device": "auto"
}
