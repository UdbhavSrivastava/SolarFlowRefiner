{
  "model": "flowrefiner-ode",
  "train_index": "splits/train_index.csv",
  "val_index": "splits/val_index.csv",
  "test_index": "splits/test_index.csv",
  "train_base_cache": "runs/base_cache/train_base.npy",
  "val_base_cache": "runs/base_cache/val_base.npy",
  "test_base_cache": "runs/base_cache/test_base.npy",
  "base_run_dir": "runs/FlowMatch",
  "out_dir": "runs/FlowRefiner-ODE",
  "epochs": 100,
  "batch_size": 8,
  "lr": 0.00002,
  "weight_decay": 0.0001,
  "base_channels": 64,
  "channel_multipliers": "1,2,4,8",
