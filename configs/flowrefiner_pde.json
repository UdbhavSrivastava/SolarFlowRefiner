{
  "model": "flowrefiner-pde",
  "train_index": "splits/train_index.csv",
  "val_index": "splits/val_index.csv",
  "test_index": "splits/test_index.csv",
  "train_base_cache": "runs/base_cache/train_base.npy",
  "val_base_cache": "runs/base_cache/val_base.npy",
  "test_base_cache": "runs/base_cache/test_base.npy",
  "base_run_dir": "runs/FlowMatch",
  "out_dir": "runs/FlowRefiner-PDE",
  "epochs": 100,
  "batch_size": 4,
  "lr": 0.00002,
  "weight_decay": 0.0001,
  "base_channels": 64,
  "channel_multipliers": "1,2,4,8",
  "res_blocks": 2,
  "refinement_steps": 8,
  "sigma_max": 0.35,
  "sigma_min": 0.01,
  "refine_strength": 1.0,
  "train_state_mode": "base_to_target",
  "loss": "l1",
  "mse_loss_weight": 0.1,
  "gradient_loss_weight": 0.05,
  "ema_decay": 0.9999,
  "early_stopping_patience": 15,
  "early_stopping_min_delta": 0.001,
  "eval_every": 1,
  "seed": 42,
  "device": "auto"
}
